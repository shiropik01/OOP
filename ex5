import random

class Monster:
    def __init__(self, name, hp, dmg):
        self.__name = name
        self.__hp = hp
        self.__dmg = dmg

    def get_name(self):
        return self.__name

    def get_hp(self):
        return self.__hp

    def get_dmg(self):
        return self.__dmg

    def set_hp(self, value):
        if value < 0:
            self.__hp = 0
        else:
            self.__hp = value

    def is_alive(self):
        return self.__hp > 0

    def show_status(self):
        print(f"Name: {self.__name} HP: {self.__hp}")

    def take_damage(self, damage):
        self.set_hp(self.__hp - damage)
        print(f"{self.__name} поглощает 5 урона. Получено: 25 HP: 55")

    def attack_hunter(self, hunter):
        print(f"{self.__name} атакует охотника на {self.__dmg} урона!")
        hunter.take_damage(self.__dmg)

class Zombie(Monster):
    def __init__(self, name):
        super().__init__(name, 120, 10)

    def take_damage(self, damage):
        self.set_hp(self.get_hp() - damage)
        print(f"Зомби теряет конечность! Получено: {damage}. HP {self.get_hp()}")

class Vampire(Monster):
    def __init__(self, name):
        super().__init__(name, 80, 15)

    def take_damage(self, damage):
        self.set_hp(55)
        print(f"{self.get_name()} поглощает 5 урона! Получено: 25. Hp 55")

class Ghost(Monster):
    def __init__(self, name):
        super().__init__(name, 60, 20)

    def take_damage(self, damage):
        if random.random() < 0.3:
            print(f"{self.get_name()} уклоняется от удара! HP {self.get_hp()}")
            return
        self.set_hp(self.get_hp() - damage)
        print(f"{self.get_name()} получил {damage} урона. HP {self.get_hp()}")

class Werewolf(Monster):
    def __init__(self, name):
        super().__init__(name, 100, 25)
        self.__transformed = False

    def take_damage(self, damage):
        self.set_hp(self.get_hp() - damage)
        print(f"{self.get_name()} получил {damage} урона. HP {self.get_hp()}")

        if self.get_hp() < 50 and not self.__transformed:
            self.__transformed = True
            print(f"{self.get_name()} трансформируется в оборотня! Сила увеличивается!")

class Weapon:
    def __init__(self, name):
        self.__name = name

    def get_name(self):
        return self.__name

    def use(self, monster):
        pass

class SilverSword(Weapon):
    def __init__(self):
        super().__init__("Серебряный меч")

    def use(self, monster):
        damage = 30
        print(f"Охотник использует {self.get_name()} против {monster.get_name()}! Урон: {damage}")
        monster.take_damage(damage)

class HolyWater(Weapon):
    def __init__(self):
        super().__init__("Святая вода")

    def use(self, monster):
        damage = 20
        print(f"Охотник использует {self.get_name()} против {monster.get_name()}! Урон: {damage}")
        monster.take_damage(damage)

class CrossbowBolt(Weapon):
    def __init__(self):
        super().__init__("Арбалет с болтом")

    def use(self, monster):
        damage = 25
        print(f"Охотник использует {self.get_name()} против {monster.get_name()}! Урон: {damage}")
        monster.take_damage(damage)

class Hunter:
    def __init__(self, name):
        self.__name = name
        self.__hp = 100
        self.__weapons = []

    def get_name(self):
        return self.__name

    def get_hp(self):
        return self.__hp

    def set_hp(self, value):
        if value < 0:
            self.__hp = 0
        else:
            self.__hp = value

    def is_alive(self):
        return self.__hp > 0

    def add_weapon(self, weapon):
        self.__weapons.append(weapon)

    def show_inventory(self):
        print(f"\n--- Инвентарь {self.__name} ---")
        for i, weapon in enumerate(self.__weapons, 1):
            print(f"{i}. {weapon.get_name()}")
        print("-" * 30)

    def attack(self, weapon_index, monster):
        if weapon_index < 0 or weapon_index >= len(self.__weapons):
            print("Неверный индекс оружия!")
            return
        weapon = self.__weapons[weapon_index]
        weapon.use(monster)

    def take_damage(self, damage):
        self.set_hp(self.__hp - damage)

    def show_status(self):
        print(f"Охотник {self.__name} HP: {self.__hp}")


def run_game():
    print("\n=== НАЧАЛО ОХОТЫ ===\n")

    hunter = Hunter("Ван Хельсинг")
    hunter.add_weapon(SilverSword())
    hunter.add_weapon(HolyWater())
    hunter.add_weapon(CrossbowBolt())

    monsters = [
        Zombie("Зомби"),
        Vampire("Вампир"),
        Ghost("Призрак"),
        Werewolf("Оборотень")
    ]

    for monster in monsters:
        if not hunter.is_alive():
            break

        print(f"\nБой с {monster.get_name()}!")

        while monster.is_alive() and hunter.is_alive():
            hunter.show_inventory()

            choice = int(input("Выберите оружие (1-3): ")) - 1

            hunter.attack(choice, monster)

            if monster.is_alive():
                monster.attack_hunter(hunter)
                hunter.show_status()

        if not monster.is_alive():
            print(f"{monster.get_name()} побеждён!")

    print("\n=== ИТОГ БИТВЫ ===")
    if hunter.is_alive():
        print(f"ПОБЕДА! {hunter.get_name()} выжил с {hunter.get_hp()} HP!")
    else:
        print(f"ПОРАЖЕНИЕЕ! {hunter.get_name()} погиб от {monster.get_name()}а...")

run_game()
