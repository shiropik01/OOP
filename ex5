import random

# ЭТАП 1 + ЭТАП 2 (базовый класс с дополнениями)
class Monster:
    def __init__(self, name, hp, dmg):
        self.__name = name
        self.__hp = hp
        self.__dmg = dmg
    
    def get_name(self): return self.__name
    def get_hp(self): return self.__hp
    def get_dmg(self): return self.__dmg
    
    def set_hp(self, value):
        self.__hp = 0 if value < 0 else value
    
    def is_alive(self): return self.__hp > 0
    def show_status(self): print(f"[{self.__name}] HP: {self.__hp}")
    
    def take_damage(self, damage):
        self.set_hp(self.get_hp() - damage)
        print(f"{self.get_name()} получает {damage} урона. HP: {self.get_hp()}")
        return damage
    
    def attack_hunter(self, hunter):
        hunter.set_hp(hunter.get_hp() - self.__dmg)
        print(f"{self.__name} атакует охотника! Нанесено урона: {self.__dmg}")

class Zombie(Monster):
    def __init__(self, name="Зомби"): super().__init__(name, 120, 10)
    def take_damage(self, damage):
        self.set_hp(self.get_hp() - damage)
        print(f"{self.get_name()} теряет конечность! Получено: {damage}. HP: {self.get_hp()}")
        return damage

class Vampire(Monster):
    def __init__(self, name="Вампир"): super().__init__(name, 80, 15)
    def take_damage(self, damage):
        actual = max(0, damage - 5)
        self.set_hp(self.get_hp() - actual)
        print(f"{self.get_name()} поглощает 5 урона! Получено: {actual}. HP: {self.get_hp()}")
        return actual

class Ghost(Monster):
    def __init__(self, name="Призрак"): super().__init__(name, 60, 20)
    def take_damage(self, damage):
        if random.random() < 0.3:
            print(f"{self.get_name()} уклоняется от удара!")
            return 0
        self.set_hp(self.get_hp() - damage)
        print(f"{self.get_name()} получает {damage} урона. HP: {self.get_hp()}")
        return damage

class Werewolf(Monster):
    def __init__(self, name="Оборотень"):
        super().__init__(name, 100, 25)
        self._transformed = False
    def take_damage(self, damage):
        self.set_hp(self.get_hp() - damage)
        print(f"{self.get_name()} получает {damage} урона. HP: {self.get_hp()}")
        if not self._transformed and self.get_hp() < 50:
            self._transformed = True
            print(f"🌕 {self.get_name()} ТРАНСФОРМИРУЕТСЯ!")
        return damage

# ЭТАП 3 - Оружие
class Weapon:
    def __init__(self, name): self.name = name
    def use(self, monster): pass

class SilverSword(Weapon):
    def __init__(self): super().__init__("Серебряный меч")
    def use(self, monster):
        print(f"⚔️ Серебряный меч наносит 30 урона {monster.get_name()}!")
        monster.take_damage(30)

class HolyWater(Weapon):
    def __init__(self): super().__init__("Святая вода")
    def use(self, monster):
        print(f"💧 Святая вода наносит 20 урона {monster.get_name()}!")
        monster.take_damage(20)

class CrossbowBolt(Weapon):
    def __init__(self): super().__init__("Арбалет с болтом")
    def use(self, monster):
        print(f"🏹 Арбалет наносит 25 урона {monster.get_name()}!")
        monster.take_damage(25)

# ЭТАП 4 - Охотник
class Hunter:
    def __init__(self, name):
        self.__name = name
        self.__hp = 100
        self.__weapons = []
    
    def get_name(self): return self.__name
    def get_hp(self): return self.__hp
    def set_hp(self, value): self.__hp = 0 if value < 0 else value
    def is_alive(self): return self.__hp > 0
    
    def add_weapon(self, weapon):
        self.__weapons.append(weapon)
    
    def show_inventory(self):
        print(f"\n--- Инвентарь {self.__name} ---")
        for i, w in enumerate(self.__weapons, 1):
            print(f"{i}. {w.name}")
    
    def attack(self, weapon_index, monster):
        if 0 <= weapon_index < len(self.__weapons):
            self.__weapons[weapon_index].use(monster)
    
    def show_status(self):
        print(f"👨 {self.__name} HP: {self.__hp}")

# ЭТАП 5 - Игровой цикл
def run_game():
    print("="*60)
    print("👻 СИМУЛЯТОР ОХОТЫ НА НЕЧИСТЬ 👻")
    print("="*60)
    
    hunter = Hunter("Ван Хельсинг")
    for w in [SilverSword(), HolyWater(), CrossbowBolt()]:
        hunter.add_weapon(w)
    
    monsters = [Zombie("Зомби"), Vampire("Вампир"), Ghost("Призрак"), Werewolf("Оборотень")]
    
    for monster in monsters:
        if not hunter.is_alive(): break
        
        print(f"\n⚔️ БОЙ С {monster.get_name().upper()}! ⚔️")
        
        while monster.is_alive() and hunter.is_alive():
            hunter.show_inventory()
            choice = int(input("Выберите оружие (1-3): ")) - 1
            hunter.attack(choice, monster)
            
            if monster.is_alive():
                monster.attack_hunter(hunter)
                hunter.show_status()
        
        if not monster.is_alive():
            print(f"✅ {monster.get_name()} побеждён!")
    
    print("\n" + "="*60)
    if hunter.is_alive():
        print(f"🎉 ПОБЕДА! Охотник выжил с {hunter.get_hp()} HP!")
    else:
        print("💀 ПОРАЖЕНИЕ! Охотник погиб...")
    print("="*60)

if __name__ == "__main__":
    run_game()
