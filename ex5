
class Hunter:
    def __init__(self, name):
        self.__name = name
        self.__hp = 100
        self.__weapons = []
    
    def get_name(self):
        return self.__name
    
    def get_hp(self):
        return self.__hp
    
    def set_hp(self, value):
        if value < 0:
            self.__hp = 0
        else:
            self.__hp = value
    
    def is_alive(self):
        return self.__hp > 0
    
    def add_weapon(self, weapon):
        self.__weapons.append(weapon)
    
    def show_inventory(self):
        print(f"\n--- Инвентарь {self.__name} ---")
        for i, weapon in enumerate(self.__weapons, 1):
            print(f"{i}. {weapon.get_name()}")
        print("-" * 30)
    
    def attack(self, weapon_index, monster):
        if weapon_index < 0 or weapon_index >= len(self.__weapons):
            print("Неверный индекс оружия!")
            return
        weapon = self.__weapons[weapon_index]
        weapon.use(monster)
    
    def take_damage(self, damage):
        self.set_hp(self.__hp - damage)
    
    def show_status(self):
        print(f"Охотник {self.__name} HP: {self.__hp}")


========== ЭТАП 5: Финальный бой ==========

def run_game():
    print("\n=== НАЧАЛО ОХОТЫ ===\n")
    
    hunter = Hunter("Ван Хельсинг")
    hunter.add_weapon(SilverSword())
    hunter.add_weapon(HolyWater())
    hunter.add_weapon(CrossbowBolt())
    
    monsters = [
        Zombie("Зомби"),
        Vampire("Вампир"),
        Ghost("Призрак"),
        Werewolf("Оборотень")
    ]
    
    for monster in monsters:
        if not hunter.is_alive():
            break
        
        print(f"\nБой с {monster.get_name()}!")
        
        while monster.is_alive() and hunter.is_alive():
            hunter.show_inventory()
            
            choice = int(input("Выберите оружие (1-3): ")) - 1
            
            hunter.attack(choice, monster)
            
            if monster.is_alive():
                monster.attack_hunter(hunter)
                hunter.show_status()
        
        if not monster.is_alive():
            print(f"{monster.get_name()} побеждён!")
    
    print("\n=== ИТОГ БИТВЫ ===")
    if hunter.is_alive():
        print(f"ПОБЕДА! {hunter.get_name()} выжил с {hunter.get_hp()} HP!")
    else:
        print(f"ПОРАЖЕНИЕ! {hunter.get_name()} погиб...")

run_game()
